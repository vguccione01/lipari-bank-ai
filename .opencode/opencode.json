{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "provider": {
    "opencode": {
      "options": {
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
      }
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": {
      "*": "ask",
      ".github/workflows/**": "deny",
      "**/*.env*": "deny",
      "**/secrets/**": "deny"
    },
    "bash": {
      "*": "ask",
      "./mvnw test*": "allow",
      "./mvnw verify": "allow",
      "docker compose*": "allow",
      "rm -rf*": "deny",
      "git push --force*": "deny"
    }
  },
  "mcp": {
    "finbank-mcp": {
      "type": "local",
      "command": ["python", "./finbank-mcp/server.py"],
      "enabled": true
    }
  }
}